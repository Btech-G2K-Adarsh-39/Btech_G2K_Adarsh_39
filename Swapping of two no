#include<stdio.h>
#include<conio.h>
int main()
{
    int a,b,temp;
    printf("Enter two number a and b : ");
    scanf("%d %d",&a,&b);
    printf("Before swapping : a=%d ,b=%d\n",a,b);
    temp=b;
    b=a;
    a=temp;
    printf("After swapping : a=%d,b=%d\n",a,b);

   
    return 0;
}